              "raw": "{{base_url}}:8084/api/inventory/health",
              "host": ["{{base_url}}"],
              "port": "8084",
              "path": ["api", "inventory", "health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Order Service 健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}:8085/api/orders/health",
              "host": ["{{base_url}}"],
              "port": "8085",
              "path": ["api", "orders", "health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为 200\", function() {",
                  "    pm.response.to.have.status(200);",
