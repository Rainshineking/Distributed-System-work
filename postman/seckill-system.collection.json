{
  "info": {
    "name": "分布式秒杀系统 - 完整测试",
    "description": "完整的秒杀系统 API 测试集合，包含用户、商品、库存、订单所有功能",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "01-服务健康检查",
      "item": [
        {
          "name": "User Service 健康检查",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}:8081/api/users/health",
              "host": ["{{base_url}}"],
              "port": "8081",
              "path": ["api", "users", "health"]
            }
          },
          "response": [],
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"状态码为 200\", function() {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "pm.test(\"服务正常\", function() {",
                  "    var jsonData = pm.response.json();",
                  "    pm.expect(jsonData.code).to.eql(200);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Product Service 健康检查",
          "request": {
            "method": "GET",
